# Server port (default: 3000)
PORT=3000

# Local cache directory for filesystem storage (default: ./.cache)
# Used when S3 is not configured (development / single-node deployments)
CACHE_DIR=./.cache

# WinGet client-visible SourceIdentifier (3-128 characters)
WINGET_SOURCE_IDENTIFIER=Funish.Nexus

# WinGet upstream index database (a source.msix containing Public/index.db)
WINGET_SOURCE_MSIX_URL=https://cdn.winget.microsoft.com/cache/source.msix

# GitHub repository and branch containing the matching manifests/<letter> tree
WINGET_GITHUB_REPO=microsoft/winget-pkgs
WINGET_GITHUB_BRANCH=master

# CDN upstream registry URLs (defaults shown; point at private mirrors if needed)
NPM_REGISTRY_URL=https://registry.npmjs.org
JSR_REGISTRY_URL=https://npm.jsr.io
GITHUB_API_BASE_URL=https://api.github.com
CDNJS_API_BASE_URL=https://api.cdnjs.com

# GitHub Token for api.github.com only (repo tags and winget-pkgs tree
# discovery). Raw manifest downloads are public content and stay unauthenticated.
# Get your token from: https://github.com/settings/tokens
# No scopes are required for public repositories.
GITHUB_TOKEN=

# Optional resource overrides. Leave every value unset to derive defaults from
# visible CPU count and the effective memory limit (cgroup limit when present).
# NEXUS_BUNDLE_CONCURRENCY=
# NEXUS_DOWNLOAD_CONCURRENCY=
# NEXUS_GITHUB_API_CONCURRENCY=
# NEXUS_DB_POOL_SIZE=
# NEXUS_MANIFEST_BUILD_CONCURRENCY=
# NEXUS_STORAGE_WRITE_CONCURRENCY=

# S3 Storage Configuration for distributed / persistent caching
# Optional: if any required field is missing, the service falls back to
# filesystem storage (CACHE_DIR). Configure all fields to enable S3 storage.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
